<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps nothing worth restoring: calibrations last for the session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
